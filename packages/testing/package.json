{
  "name": "@anyhook/testing",
  "version": "0.2.0",
  "description": "In-memory transport/state/scheduler + scriptable MockReceiver for testing anyhook engines",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "import": "./dist/index.js", "types": "./dist/index.d.ts" } },
  "files": ["dist"],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun && bun run build:types",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@anyhook/core": "workspace:*",
    "@anyhook/signing": "workspace:*"
  },
  "peerDependencies": { "@anyhook/core": "workspace:*" },
  "devDependencies": { "@types/bun": "^1.1.0", "typescript": "^5.3.0" },
  "keywords": ["anyhook", "testing", "mock", "in-memory"],
  "license": "MIT",
  "author": "Shantanu Sharma",
  "publishConfig": { "access": "public" }
}
